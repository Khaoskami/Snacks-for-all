# Required for authentication (from Clerk Dashboard > API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Required for recipe/account storage (Railway Postgres can provide this)
DATABASE_URL=postgresql://...

# Recipe API: key 1 is for development/education. Review provider terms before public launch.
THEMEALDB_API_KEY=1

# Optional: identify your Open Food Facts requests. No API key is required for read operations.
OPEN_FOOD_FACTS_USER_AGENT=SnacksForAll/1.0

# Optional: enable the real donation link
NEXT_PUBLIC_PAYPAL_DONATION_URL=

# Optional: enable the order-request email button in Shop
NEXT_PUBLIC_ORDER_EMAIL=
