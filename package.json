{
  "name": "recipe-app",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-build.mjs && next dev",
    "build": "node scripts/prepare-build.mjs && prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "typecheck": "node scripts/prepare-build.mjs && next typegen && tsc --noEmit",
    "db:setup": "prisma db push"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.4",
    "@prisma/client": "5.10.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.29",
    "prisma": "5.10.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.2",
    "vitest": "5.0.3"
  }
}
